            <!-- Calendar Card (Wraps the Calendar View) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_16"
                android:layout_marginHorizontal="@dimen/margin_2"
                app:cardCornerRadius="@dimen/margin_16"
                app:cardElevation="@dimen/margin_6"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_with_subtle_border">

                    <!-- Header (Month-Year + Arrows) -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FAFAFA"
                        android:paddingVertical="@dimen/margin_12"
                        android:paddingHorizontal="@dimen/margin_16">

                        <ImageView
                            android:id="@+id/img_prev_month"
                            android:layout_width="@dimen/margin_24"
                            android:layout_height="@dimen/margin_24"
                            android:layout_alignParentStart="true"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/black"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textMonthYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="September 2025"
                            android:textSize="@dimen/font_size_18"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            android:textColor="@color/black" />

                        <ImageView
                            android:id="@+id/img_next_month"
                            android:layout_width="@dimen/margin_24"
                            android:layout_height="@dimen/margin_24"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/black"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <!-- 🧩 FrameLayout wrapping the calendar + loading spinner -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/margin_8"
                            app:mcv_showOtherDates="all"
                            android:background="@color/white"
                            app:mcv_selectionColor="@color/present_day"
                            app:mcv_weekDayTextAppearance="@style/CalendarWeekText"
                            app:mcv_dateTextAppearance="@style/CalendarDayText"
                            app:mcv_calendarMode="month"
                            app:mcv_headerTextAppearance="@style/CalendarHeaderInvisible" />

                        <!-- Loading spinner only over the calendar -->
                        <ProgressBar
                            android:id="@+id/calendarLoadingSpinner"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/colorPrimary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="@dimen/margin_10"
                        android:text="© 2025 AVS in-so-tech. All rights reserved."
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>





        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary" />

    </FrameLayout>


</LinearLayout>
