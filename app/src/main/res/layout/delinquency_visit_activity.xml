    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginHorizontal="@dimen/margin_4">

        <RadioGroup
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/margin_2">

            <!-- Pending option -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/cardview_border"
                android:gravity="center"

                android:layout_marginEnd="6dp"
                >

                <!-- Top row: Radio + Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:buttonTint="@color/black"
                        android:textColor="@color/black" />
                </LinearLayout>

                <!-- Bottom row: Count -->
                <TextView
                    android:id="@+id/tvPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:minHeight="32dp"
                    android:padding="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/circle_count_bg" />

            </LinearLayout>



            <!-- Visit Again option -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/cardview_border"
                android:layout_marginEnd="6dp"
                android:gravity="center">

                <!-- Top row: Radio + Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbVisitAgain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visit Again"
                        android:buttonTint="@color/black"
                        android:textColor="@color/black" />
                </LinearLayout>

                <!-- Bottom row: Count -->
                <TextView
                    android:id="@+id/tvVisitAgainCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:minHeight="32dp"
                    android:padding="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/circle_count_bg" />

            </LinearLayout>





            <!-- Done option -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/cardview_border"
                android:gravity="center">

                <!-- Top row: Radio + Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done"
                        android:buttonTint="@color/black"
                        android:textColor="@color/black" />
                </LinearLayout>

                <!-- Bottom row: Count -->
                <TextView
                    android:id="@+id/tvDoneCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:minHeight="32dp"
                    android:padding="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/circle_count_bg" />

            </LinearLayout>

        </RadioGroup>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvvisit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_550"
        android:layout_weight="1"
        android:visibility="visible"
        android:padding="@dimen/margin_10" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linearLayoutUpload1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_8"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_photo"
                    android:layout_width="@dimen/margin_150"
                    android:layout_height="@dimen/margin_150"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/user_profile"
                    app:shapeAppearanceOverlay="@style/RoundedImageView" />

                <Button
                    android:id="@+id/buttonUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:text="Capture Image"
                    android:textColor="@color/primarydark"
                    android:textSize="@dimen/font_size_12" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etDateLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Visit Date"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:textSize="@dimen/font_size_14"
                    android:focusable="false"
                    android:clickable="false"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etVisitTimeLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Visit Time"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_VisitTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="10"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:textSize="@dimen/font_size_14"
                    android:focusable="false"
                    android:clickable="false"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etLatLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Current Latitude"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Lat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:focusable="false"
                    android:clickable="false"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:textSize="@dimen/font_size_14"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etLongLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Current Longitude"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Long"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:focusable="false"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:clickable="false"
                    android:textSize="@dimen/font_size_14"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etAddressLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Current Address"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:clickable="false"
                    android:textSize="@dimen/font_size_14"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/StaffNameLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Staff Name"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                android:enabled="false"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/Staff_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:maxLength="50"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_14" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/branchNameLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Customer Branch Name"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                android:enabled="false"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <AutoCompleteTextView
                    android:id="@+id/branchName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:dropDownWidth="wrap_content"
                    android:dropDownHeight="wrap_content"
                    android:focusable="false"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/color"
                    android:inputType="text"
                    android:paddingVertical="@dimen/margin_15"
                    android:paddingLeft="@dimen/margin_15"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_14"  />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/branchCodeLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Customer Branch Code"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:textColorHint="@color/colorPrimaryDark"
                android:layout_marginTop="@dimen/margin_8"
                app:boxBackgroundMode="outline"
                android:enabled="false"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <AutoCompleteTextView
                    android:id="@+id/branch_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:enabled="false"
                    android:paddingLeft="@dimen/margin_15"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_14"
                    android:paddingVertical="@dimen/margin_15"
                    android:dropDownHeight="wrap_content"
                    android:dropDownWidth="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/CustnameLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:layout_marginTop="@dimen/margin_8"
                android:enabled="false"
                android:hint="Customer Name"
                android:textColorHint="@color/colorPrimaryDark"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <AutoCompleteTextView
                    android:id="@+id/Custname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:dropDownWidth="wrap_content"
                    android:dropDownHeight="wrap_content"
                    android:focusable="false"
                    android:inputType="text"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/color"
                    android:paddingVertical="@dimen/margin_15"
                    android:paddingLeft="@dimen/margin_15"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_14" />

                </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/LoanAcNoLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Loan Account No"
                    android:layout_marginHorizontal="@dimen/margin_8"
                    android:textColorHint="@color/colorPrimaryDark"
                    android:layout_marginTop="@dimen/margin_8"
                    android:enabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/colorPrimaryDark"
                    app:hintTextColor="@color/colorPrimaryDark">


                    <AutoCompleteTextView
                        android:id="@+id/LoanAcNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="@color/auto_fill_bg"
                        android:dropDownWidth="wrap_content"
                        android:dropDownHeight="wrap_content"
                        android:focusable="false"
                        android:inputType="number"
                        android:paddingVertical="@dimen/margin_15"
                        android:paddingLeft="@dimen/margin_15"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_14" />

                </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/LoanTypeLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_8"
                    android:hint="Loan type"
                    android:enabled="false"
                    android:textColorHint="@color/colorPrimaryDark"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/colorPrimaryDark"
                    app:hintTextColor="@color/colorPrimaryDark">

                    <AutoCompleteTextView
                        android:id="@+id/LoanType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="@color/auto_fill_bg"
                        android:dropDownWidth="wrap_content"
                        android:dropDownHeight="wrap_content"
                        android:focusable="false"
                        android:inputType="text"
                        android:paddingVertical="@dimen/margin_15"
                        android:paddingLeft="@dimen/margin_15"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_14" />
                </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/CustMobNoLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_8"
                    android:hint="Customer Mobile No"
                    android:textColorHint="@color/colorPrimaryDark"
                    app:boxBackgroundMode="outline"
                    android:enabled="false"
                    app:boxStrokeColor="@color/colorPrimaryDark"
                    app:hintTextColor="@color/colorPrimaryDark">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/CustMobNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="@color/auto_fill_bg"
                        android:maxLength="10"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_14" />
                </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/OverdueAmountLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_8"
                android:layout_marginTop="@dimen/margin_8"
                android:hint="Overdue Amount"
                android:enabled="false"
                android:textColorHint="@color/colorPrimaryDark"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimaryDark"
                app:hintTextColor="@color/colorPrimaryDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/OverdueAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="@color/auto_fill_bg"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_14" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/LoanCategoryLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_8"
                    android:layout_marginTop="@dimen/margin_8"
                    android:enabled="false"
                    android:hint="Loan Category ( Asset code)"
                    android:textColorHint="@color/colorPrimaryDark"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/colorPrimaryDark"
                    app:hintTextColor="@color/colorPrimaryDark">

