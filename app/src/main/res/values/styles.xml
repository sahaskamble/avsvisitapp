<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- App color scheme -->
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorPrimaryDark</item>

        <!-- Set dark status bar background -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Show white icons in status bar -->
        <item tools:targetApi="23" name="android:windowLightStatusBar">true</item>

    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="TabLayoutStyle" parent="Base.Widget.Design.TabLayout">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style
        name="Custom_Profile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/margin_12</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">@dimen/margin_12</item>
        <item name="android:paddingRight">@dimen/margin_12</item>
        <item name="android:paddingTop">@dimen/margin_12</item>
        <item name="android:paddingBottom">@dimen/margin_12</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:textSize">@dimen/font_size_14</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:textColorHighlight">@color/black</item>
        <item name="android:textColorLink">@color/black</item>
        <item name="android:layout_marginTop">@dimen/margin_8</item>
    </style>


    <style name="CustomEditTextProfile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/custom_edit</item>
        <item name="android:drawablePadding">@dimen/margin_12</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">@dimen/margin_12</item>
        <item name="android:paddingRight">@dimen/margin_12</item>
        <item name="android:paddingTop">@dimen/margin_12</item>
        <item name="android:paddingBottom">@dimen/margin_12</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:textSize">@dimen/font_size_12</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:textColorHighlight">@color/black</item>
        <item name="android:textColorLink">@color/black</item>
        <item name="android:layout_marginTop">@dimen/margin_8</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item> <!-- Adjust this for more or less rounded corners -->
    </style>

    <style name="ShapeAppearanceOverlay.MaterialComponents.ImageView.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


    <style name="CustomDatePickerDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <!-- Header background -->
        <item name="colorPrimary">@color/black</item>

        <!-- Header text color (month and year) -->
        <item name="android:textColorPrimary">@color/teal_700</item>

        <!-- Calendar day selector color -->
        <item name="colorAccent">@color/card_even</item>

        <!-- Date picker background -->
        <item name="android:background">@color/white</item>
    </style>


    <style name="CalendarHeaderText" parent="TextAppearance.MaterialCalendarWidget.Header">
        <item name="android:textColor">#000000</item> <!-- Black -->
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalendarWeekText" parent="TextAppearance.MaterialCalendarWidget.WeekDay">
        <item name="android:textColor">#000000</item> <!-- Black -->
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimaryDark</item>
        <item name="hintTextColor">@color/colorPrimaryDark</item>
    </style>


    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">80%</item>
    </style>

    <style name="CalendarHeaderInvisible">
        <item name="android:textSize">0sp</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="CalendarDayText" parent="TextAppearance.AppCompat.Small">
        <!-- Adjust font size for the day numbers -->
        <item name="android:textSize">14sp</item>
        <!-- Default color for inactive/unselected days -->
        <item name="android:textColor">#333333</item>
    </style>

</resources>
