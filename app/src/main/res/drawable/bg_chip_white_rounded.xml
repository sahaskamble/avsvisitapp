<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional Shadow Layer (bottom layer) -->
    <!-- This gives the slight lift/shadow effect seen in the image. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" /> <!-- Slightly more rounded corners for a chip look -->
            <solid android:color="#1A000000" /> <!-- Semi-transparent black for shadow color -->
            <padding android:bottom="1dp" android:right="1dp" android:left="1dp" android:top="1dp"/>
        </shape>
    </item>

    <!-- Main White Background Layer (top layer) -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@android:color/white" />
            <!-- Optional subtle border if needed -->
            <stroke android:width="1dp" android:color="#ECECEC" />
        </shape>
    </item>
</layer-list>
